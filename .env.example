# Spotify Dashboard Configuration
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to git (it contains secrets)

# Spotify API Configuration
# Create an app at: https://developer.spotify.com/dashboard
# Choose "Web API" as the API type

# Your Spotify Client ID (Safe to keep in frontend - this is public)
VITE_SPOTIFY_CLIENT_ID=your_client_id_here

# Spotify Redirect URI (must match exactly in your Spotify Dashboard)
# Note: Spotify requires 127.0.0.1, not localhost
# Use port 3001 if 3000 is occupied, otherwise use 3000
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/callback

# Firebase Functions URL
# For local development with emulator, use: http://127.0.0.1:5001/new-year-dashboard/us-central1
# For production, use: https://us-central1-new-year-dashboard.cloudfunctions.net
VITE_FIREBASE_FUNCTIONS_URL=http://127.0.0.1:5001/new-year-dashboard/us-central1
