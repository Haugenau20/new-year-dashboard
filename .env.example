# Home Assistant Configuration
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to git (it contains secrets)

# Your Home Assistant URL (http or https)
# Example: http://homeassistant.local:8123 or http://192.168.1.100:8123
VITE_HA_URL=http://homeassistant.local:8123

# Your Home Assistant Long-Lived Access Token
# Create one at: http://YOUR_HA_URL/profile (scroll down to "Long-Lived Access Tokens")
VITE_HA_TOKEN=your_token_here

# Spotify API Configuration
# Create an app at: https://developer.spotify.com/dashboard
# Choose "Web API" as the API type

# Your Spotify Client ID
VITE_SPOTIFY_CLIENT_ID=your_client_id_here

# Your Spotify Client Secret
VITE_SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Spotify Redirect URI (must match exactly in your Spotify Dashboard)
# Note: Spotify requires 127.0.0.1, not localhost
# Use port 3001 if 3000 is occupied, otherwise use 3000
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/callback
